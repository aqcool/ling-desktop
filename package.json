{
  "name": "ling-desktop",
  "version": "0.0.0-dev.9",
  "private": true,
  "description": "LING-owned desktop renderer foundation",
  "license": "MIT",
  "type": "module",
  "exports": {
    "./client": "./src/client.tsx",
    "./runtime": "./src/runtime/contract.ts",
    "./package.json": "./package.json",
    "./theme": "./src/theme/tokens.ts"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "corepack pnpm --filter ling-desktop-host dev",
    "start": "corepack pnpm --filter ling-desktop-host start",
    "dev:demo": "VITE_LING_DEMO=1 vite",
    "serve:web": "corepack pnpm build && corepack pnpm --filter ling-desktop-host serve:web",
    "build": "corepack pnpm build:renderer && corepack pnpm --filter ling-desktop-host build",
    "build:renderer": "node scripts/generate-theme.mjs && corepack pnpm typecheck:renderer && vite build && node scripts/office-notices.mjs",
    "typecheck": "corepack pnpm typecheck:renderer && corepack pnpm --filter ling-desktop-host typecheck",
    "typecheck:renderer": "tsc --noEmit",
    "test": "corepack pnpm test:renderer && corepack pnpm --filter ling-desktop-host test",
    "test:renderer": "vitest run",
    "check:boundary": "node scripts/verify-boundary.mjs",
    "check:heroui": "node scripts/generate-theme.mjs --check && node scripts/verify-heroui-setup.mjs",
    "check:theme": "node scripts/generate-theme.mjs --check && node scripts/verify-theme.mjs",
    "check:renderer": "corepack pnpm build:renderer && corepack pnpm check:boundary && corepack pnpm check:heroui && corepack pnpm check:theme && corepack pnpm test:renderer",
    "check": "corepack pnpm check:runtime && corepack pnpm test:release && corepack pnpm check:renderer && corepack pnpm --filter ling-desktop-host check",
    "check:runtime": "node scripts/verify-runtime.mjs",
    "package:dir": "corepack pnpm --filter ling-desktop-host package:dir",
    "dist:mac": "corepack pnpm --filter ling-desktop-host package:mac",
    "check:package": "corepack pnpm --filter ling-desktop-host check:package",
    "dist": "corepack pnpm --filter ling-desktop-host package",
    "dist:win": "corepack pnpm --filter ling-desktop-host package:win",
    "dist:linux": "corepack pnpm --filter ling-desktop-host package:linux",
    "release:version": "node scripts/release-version.mjs",
    "test:release": "node --test scripts/release-version.test.mjs scripts/release-assets.test.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@deepseek-ai/dsh-api-session-controller": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-api-workspace-controller": "0.1.6-alpha.2",
    "@heroui/react": "3.2.6",
    "@heroui/styles": "3.2.6",
    "@internationalized/date": "3.12.4",
    "@lezer/highlight": "^1.2.5",
    "@react-aria/ssr": "3.10.1",
    "@react-aria/utils": "3.34.1",
    "@univerjs/core": "1.0.3",
    "@univerjs/drawing": "1.0.3",
    "@univerjs/preset-docs-core": "1.0.3",
    "@univerjs/preset-docs-drawing": "1.0.3",
    "@univerjs/preset-sheets-core": "1.0.3",
    "@univerjs/presets": "1.0.3",
    "@univerjs/slides": "1.0.3",
    "@univerjs/slides-ui": "1.0.3",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "cytoscape": "3.34.3",
    "exceljs": "4.4.0",
    "fflate": "0.8.3",
    "react": "19.3.0",
    "react-aria": "3.52.1",
    "react-aria-components": "1.21.1",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "rxjs": "7.8.2",
    "tailwind-merge": "3.6.0",
    "tailwind-variants": "3.3.1",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/cytoscape": "^3.31.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "29.1.1",
    "typescript": "6.0.3",
    "vite": "8.3.0",
    "vitest": "4.1.8"
  },
  "packageManager": "pnpm@11.8.0"
}
