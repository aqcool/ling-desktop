{
  "name": "ling-desktop",
  "version": "0.0.0-dev.0",
  "private": true,
  "description": "LING-owned desktop renderer foundation",
  "license": "MIT",
  "type": "module",
  "exports": {
    "./client": "./src/client.tsx",
    "./runtime": "./src/runtime/contract.ts",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "yarn typecheck && vite build",
    "typecheck": "tsc --noEmit",
    "check:boundary": "node scripts/verify-boundary.mjs",
    "check:heroui": "node scripts/verify-heroui-setup.mjs",
    "test": "vitest run",
    "check": "yarn build && yarn check:boundary && yarn check:heroui && yarn test"
  },
  "dependencies": {
    "@deepseek-ai/dsh-api-session-controller": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-api-workspace-controller": "0.1.6-alpha.2",
    "@heroui/react": "3.2.6",
    "@heroui/styles": "3.2.6",
    "@internationalized/date": "3.12.4",
    "@react-aria/ssr": "3.10.1",
    "@react-aria/utils": "3.34.1",
    "react": "19.3.0",
    "react-aria": "3.52.1",
    "react-aria-components": "1.21.1",
    "react-dom": "19.3.0",
    "tailwind-variants": "3.3.1",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "6.0.3",
    "vite": "8.3.0",
    "vitest": "4.1.8"
  }
}
